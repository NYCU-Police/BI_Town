BI_TOWN_PORT=8100
POSTGRES_DB=bi_town
POSTGRES_USER=bi_town
POSTGRES_PASSWORD=changeme
ENVIRONMENT=staging
# cloudflared sidecar. Empty locally / in CI (profile "tunnel" is not started).
# Staging: docker compose --profile tunnel up  (requires a real token in deploy/.env).
TUNNEL_TOKEN=
# GIT_COMMIT is an image build arg. DEPLOYED_AT is container env, set when
# the container is created. Leave both unset locally; /api/health reports "unknown".
# Resident brain. rules (default) keeps the schedule. Set llm to enable
# Mina, Alex, and Rin. Ollama runs on the host, not in this compose file.
BRAIN_MODE=rules
# Reach the host from the backend container (see extra_hosts in compose).
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:14b
LLM_TIMEOUT=60
# true 讓 Ollama 先思考再回答。預設 false。逾時仍看 LLM_TIMEOUT，預設 60 秒。
LLM_THINK=false
