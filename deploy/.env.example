BI_TOWN_PORT=8100
POSTGRES_DB=bi_town
POSTGRES_USER=bi_town
POSTGRES_PASSWORD=changeme
ENVIRONMENT=staging
# cloudflared sidecar. Empty locally / in CI (profile "tunnel" is not started).
# Staging: docker compose --profile tunnel up  (requires a real token in deploy/.env).
TUNNEL_TOKEN=
# GIT_COMMIT and DEPLOYED_AT are build args, injected by the deploy workflow.
# Leave them unset locally; the image then reports "unknown".
