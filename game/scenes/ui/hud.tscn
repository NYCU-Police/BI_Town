[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/event_log.gd" id="2_log"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.08, 0.09, 0.11, 0.94)
border_width_left = 1
border_color = Color(0.24, 0.27, 0.3, 1)

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Panel" type="Panel" parent="."]
anchors_preset = 11
anchor_left = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -360.0
grow_horizontal = 0
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.93, 0.9, 1)
theme_override_font_sizes/font_size = 28
text = "BI_Town v0.1"

[node name="TimeLabel" type="Label" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.86, 0.86, 0.82, 1)
theme_override_font_sizes/font_size = 20
text = "Day — --:--"

[node name="StatusLabel" type="Label" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.32, 0.32, 1)
theme_override_font_sizes/font_size = 16
text = "Server  ● Offline"

[node name="AgentsLabel" type="Label" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.78, 1)
text = "Agents: 0"

[node name="Separator" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="EventLogTitle" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.72, 1)
text = "Event Log"

[node name="EventLog" type="RichTextLabel" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.82, 0.82, 0.78, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = false
text = ""
scroll_active = true
script = ExtResource("2_log")
